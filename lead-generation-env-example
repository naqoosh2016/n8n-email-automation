# ============================================
# Workflow Parameters
# ============================================

# Default search parameters
DEFAULT_KEYWORD=restaurant
DEFAULT_LOCATION=San Francisco, CA
DEFAULT_RADIUS=5000
DEFAULT_BUSINESS_TYPE=restaurant
DEFAULT_MAX_RESULTS=20

# Rate limiting (milliseconds)
API_DELAY=2000
BATCH_DELAY=60000
RETRY_DELAY=5000

# Timeouts (seconds)
HTTP_TIMEOUT=30
WEBSITE_FETCH_TIMEOUT=10
API_REQUEST_TIMEOUT=15

# ============================================
# Webhooks & Callbacks
# ============================================

# Webhook for real-time notifications
WEBHOOK_URL=https://your-domain.com/webhook/leads

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
