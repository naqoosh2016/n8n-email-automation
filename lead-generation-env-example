SLACK_BOT_NAME=LeadBot

# Discord Integration (Optional)
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your/webhook/url

# ============================================
# Database Configuration (Optional)
# ============================================

# PostgreSQL
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=lead_generation
DB_SSL=false

# MongoDB
MONGO_URI=mongodb://localhost:27017/lead_generation

# ============================================
# Cache Configuration (Optional)
# ============================================

# Redis for caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TTL=86400

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file paths
LOG_DIR=./logs
LOG_FILE_LEADS=./logs/leads.log
LOG_FILE_ERRORS=./logs/errors.log

# ============================================
# Data Processing Options
# ============================================

# Enable duplicate detection
ENABLE_DUPLICATE_CHECK=true

# Enable sentiment analysis
ENABLE_SENTIMENT_ANALYSIS=true

# Enable geographic filtering
ENABLE_GEO_FILTERING=false
GEO_FILTER_RADIUS=10

# ============================================
# Export Settings
# ============================================

# Export format: json, csv, excel, sheets
EXPORT_FORMAT=sheets

# Export path for local files
EXPORT_PATH=./exports

# Auto-archive leads older than (days)
ARCHIVE_AFTER_DAYS=90

# ============================================
# Security Settings
# ============================================

# Enable API key rotation
ENABLE_KEY_ROTATION=true
KEY_ROTATION_INTERVAL=7776000

# IP Whitelist for API access
IP_WHITELIST=127.0.0.1,192.168.1.0/24

# Enable request signing
ENABLE_REQUEST_SIGNING=true

# ============================================
# Advanced Options
# ============================================

# Proxy settings (if behind corporate proxy)
HTTP_PROXY=http://proxy.company.com:8080
HTTPS_PROXY=https://proxy.company.com:8080

# Browser User Agent (for web scraping)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Verify SSL Certificates
VERIFY_SSL=true

# Maximum retries for failed API calls
MAX_RETRIES=3

# ============================================
# Notification Settings
# ============================================

# Send notifications on completion
NOTIFY_ON_COMPLETION=true

# Send notifications on errors
NOTIFY_ON_ERROR=true

# Notification threshold (priority score)
ALERT_THRESHOLD_SCORE=80

# ============================================
# Custom Parameters
# ============================================

# Your custom settings below
CUSTOM_FIELD_1=value1
CUSTOM_FIELD_2=value2

# ============================================
# Notes
# ============================================

# To get Gmail App Password:
# 1. Enable 2FA on Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Copy generated password (16 characters, 4 groups)
# 5. Paste here without spaces: "xxxx xxxx xxxx xxxx"

# To get Google Sheets ID:
# URL: https://docs.google.com/spreadsheets/d/{ID}/edit
# ID is the long string between /d/ and /edit

# To get Google Drive Folder ID:
# Right-click folder → Share → URL contains /folders/{ID}

# To create n8n API Key:
# n8n Dashboard → Settings → API → Create API Key

# To create LinkedIn API Access Token:
# https://www.linkedin.com/developers/apps
# → Select app → Auth → Create access token

