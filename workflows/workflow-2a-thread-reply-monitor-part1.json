{
  "name": "Workflow 2A - Thread Reply Monitor (Part 1)",
  "nodes": [
    {
      "parameters": {
        "interval": [10],
        "unit": "minutes"
      },
      "id": "Schedule Trigger",
      "name": "Schedule Trigger - 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [50, 100]
    },
    {
      "parameters": {
        "mailbox": "INBOX",
        "searchCriteria": "is:unread",
        "simple": false,
        "returnFormat": "resolved",
        "options": {}
      },
      "id": "Gmail Thread Search",
      "name": "Gmail Thread Search",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [250, 100],
      "credentials": {
        "gmailOAuth2": "gmail_credentials"
      }
    },
    {
      "parameters": {
        "messageId": "={{ $json.threadId }}"
      },
      "id": "Retrieve Thread History",
      "name": "Retrieve Thread History",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [450, 100],
      "credentials": {
        "gmailOAuth2": "gmail_credentials"
      }
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "messages": {
          "values": [
            {
              "content": "=You are a professional customer service AI handling ongoing email threads. Analyze the latest customer reply and generate a contextual response in JSON format:\n\nSubject: {{ $json.subject }}\nBody: {{ $json.body }}\n\nRespond with:\n{\n  \"category\": \"[classification]\",\n  \"sentiment\": \"[sentiment]\",\n  \"priority\": \"[priority]\",\n  \"confidence_score\": \"[score]\",\n  \"response_body\": \"[150-250 word response]\",\n  \"thread_status\": \"[Active/Resolved]\"\n}"
            }
          ]
        }
      },
      "id": "AI Thread Analyzer",
      "name": "AI Thread Analyzer",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [650, 100],
      "credentials": {
        "anthropicApi": "anthropic_credentials"
      }
    },
    {
      "parameters": {
        "toEmail": "={{ $json.from[0].email }}",
        "subject": "=RE: {{ $json.subject }}",
        "message": "={{ JSON.parse($json.content[0].text).response_body }}"
      },
      "id": "Send Thread Reply",
      "name": "Send Thread Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [850, 100],
      "credentials": {
        "gmailOAuth2": "gmail_credentials"
      }
    },
    {
      "parameters": {
        "messageId": "={{ $json.id }}",
        "action": "markAsRead"
      },
      "id": "Mark Reply Read",
      "name": "Mark Reply Read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1050, 100],
      "credentials": {
        "gmailOAuth2": "gmail_credentials"
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Gmail Thread Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail Thread Search": {
      "main": [
        [
          {
            "node": "Retrieve Thread History",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retrieve Thread History": {
      "main": [
        [
          {
            "node": "AI Thread Analyzer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Thread Analyzer": {
      "main": [
        [
          {
            "node": "Send Thread Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Thread Reply": {
      "main": [
        [
          {
            "node": "Mark Reply Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
